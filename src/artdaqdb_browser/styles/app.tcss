/* OTS Browser Global Styles
 *
 * This stylesheet uses Textual's design system variables which are
 * automatically populated by the active theme. The theme can be
 * configured in appconfig.yml under ui.theme.
 *
 * Available themes (12 total):
 *   Dark: catppuccin-mocha, textual-dark, textual-ansi, dracula,
 *         flexoki, gruvbox, monokai, nord, tokyo-night
 *   Light: catppuccin-latte, textual-light, solarized-light
 *
 * Standard variables: $primary, $secondary, $accent, $success, $warning,
 * $error, $background, $surface, $panel, $foreground, $text-muted, etc.
 *
 * Documentation: https://textual.textualize.io/guide/design/
 */

/* Global App Styles */
Screen {
    background: $background;
    color: $text;
}

/* Header and Footer */
Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: transparent;
    color: $text-muted;
}

/* Key Help Panel */
.key-panel {
    dock: right;
    width: 20;
    height: 100%;
    background: $surface;
    border-left: solid $border;
    padding: 1;
}

.key-panel-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.key-item {
    height: auto;
    margin-bottom: 1;
}

.key-binding {
    color: $accent;
    text-style: bold;
}

.key-description {
    color: $text-muted;
}

/* DataTable Styles */
DataTable {
    background: transparent;
    color: $text;
}

DataTable > .datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: transparent;
}

DataTable > .datatable--even-row {
    background: transparent;
}

DataTable > .datatable--odd-row {
    background: transparent;
}

/* Button Styles */
Button {
    background: $primary;
    color: $background;
    border: none;
    text-style: bold;
}

Button:hover {
    background: $accent;
    color: $background;
}

Button:focus {
    border: solid $success;
}

Button.-danger {
    background: $error;
    color: $background;
}

Button.-secondary {
    background: $surface;
    border: solid $border;
    color: $text;
}

/* Input Styles */
Input {
    background: transparent;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: solid $primary;
}

/* Container and Layout */
Container {
    background: transparent;
}

Vertical {
    background: transparent;
}

Horizontal {
    background: transparent;
}

/* FooterBar - always visible at bottom of screen */
FooterBar {
    dock: bottom;
    width: 100%;
    height: 1;
    background: $footer-background;
    color: $text-muted;
}

/* Static Text */
Static {
    color: $text;
}

Static.-muted {
    color: $text-muted;
}

Static.-primary {
    color: $primary;
}

Static.-success {
    color: $success;
}

Static.-warning {
    color: $warning;
}

Static.-danger {
    color: $error;
}

/* ListView */
ListView {
    background: transparent;
    border: solid $border;
}

ListItem {
    background: transparent;
    color: $text;
    padding: 1 2;
}

ListItem:hover {
    background: transparent;
}

ListItem > Label {
    width: 100%;
}

ListItem.-highlighted {
    background: $primary;
    color: $background;
    text-style: bold;
}

ListItem.-highlighted > Label {
    width: 100%;
    background: $primary;
    color: $background;
    text-style: bold;
}

/* TextArea (JSON Viewer) */
TextArea {
    background: transparent;
    color: $text;
    border: solid $border;
}

TextArea:focus {
    border: solid $primary;
}

/* Scrollbar - Hidden by default for cleaner UI */
Screen {
    scrollbar-size: 0 0;
}

ScrollBar {
    background: transparent;
    width: 0;
    height: 0;
}

TextArea {
    scrollbar-size: 0 0;
}

DataTable {
    scrollbar-size: 0 0;
}

/* Status indicators */
.status-active {
    color: $success;
}

.status-deleted {
    color: $text-muted;
    text-style: strike;
}

.status-readonly {
    color: $warning;
}

/* Tabs */
TabbedContent {
    background: $background;
}

TabPane {
    background: $background;
}

Tabs {
    background: $surface;
}

Tab {
    color: $text-muted;
}

Tab:hover {
    color: $text;
    background: $panel;
}

Tab.-active {
    color: $primary;
    background: $panel;
    text-style: bold;
}

/* Modal Screen Overlay */
ModalScreen {
    background: $background 85%;  /* Theme background with 85% opacity */
}

/* Collapsible */
Collapsible {
    background: $background;
    border: solid $border;
}

CollapsibleTitle {
    background: $surface;
    color: $primary;
}

CollapsibleTitle:hover {
    background: $primary;
    color: $background;
}

/* Common Screen Styles */
.screen-header {
    height: 1;
    background: transparent;
}

.screen-title {
    text-style: bold;
    color: $primary;
    background: transparent;
}

.status-bar {
    height: 1;
    margin: 0 2;
    color: $text-muted;
    background: transparent;
}

/* Screen DataTable defaults */
Screen DataTable {
    height: 1fr;
    margin: 0 2;
}

/* FilterInput defaults */
FilterInput {
    margin: 0;
}

/* ListView selection styles (for document_view config list) */
ListItem.--selected {
    background: $primary;
    color: $background;
    text-style: bold;
}

ListItem.--selected > Label {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* Mouse hover effects for ListItems */
ListItem:hover {
    background: $panel;
}

ListItem:hover > Label {
    background: $panel;
}

/* DataTable row hover */
DataTable > .datatable--cursor:hover {
    background: $primary;
}

/* ===========================================
   Screen-Specific Styles
   =========================================== */

/* HomeScreen Layout */
HomeScreen {
    layout: vertical;
}

HomeScreen .top-half {
    height: 50%;
    align: center middle;
}

HomeScreen .bottom-half {
    height: 50%;
    align: center top;
    padding: 0;
}

HomeScreen .menu-container {
    width: auto;
    height: auto;
    border: none;
    background: transparent;
    padding: 0 4;
}

HomeScreen #menu_table {
    height: auto;
    width: auto;
    background: transparent;
}

HomeScreen .summary-container {
    width: 100%;
    max-width: 80;
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

HomeScreen .summary-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

HomeScreen .summary-row {
    height: 1;
    margin-bottom: 0;
}

HomeScreen .summary-label {
    width: 20;
    color: $text-muted;
}

HomeScreen .summary-value {
    color: $text;
}

HomeScreen .summary-divider {
    height: 1;
    margin: 0;
    background: transparent;
}

HomeScreen #loading_progress {
    width: 100%;
    height: 1;
    background: transparent;
    margin: 1 4;
}

/* ConfigurationListScreen Layout */
ConfigurationListScreen {
    layout: vertical;
}

/* CollectionTableScreen Layout */
CollectionTableScreen {
    layout: vertical;
}

/* VersionListScreen Layout */
VersionListScreen {
    layout: vertical;
}

/* CollectionBrowserScreen Layout */
CollectionBrowserScreen {
    layout: vertical;
}

/* TraceViewerScreen Layout */
TraceViewerScreen {
    layout: vertical;
}

TraceViewerScreen #trace_filter_row {
    height: 1;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
}

TraceViewerScreen #trace_filter_row.hidden {
    display: none;
}

TraceViewerScreen .trace-main-content {
    height: 1fr;
    background: transparent;
    padding: 0;
    margin: 0;
}

TraceViewerScreen .trace-list-pane {
    height: 1fr;
    background: transparent;
    padding: 0;
    margin: 0;
}

TraceViewerScreen .trace-detail-pane {
    height: 1fr;
    background: transparent;
    padding: 0;
    margin: 0;
}

TraceViewerScreen .entry-status-bar {
    height: 1;
    color: $background;
    background: $secondary;
    text-style: bold;
    padding: 0 1;
}

TraceViewerScreen #trace_table {
    height: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

TraceViewerScreen #trace_table.hidden {
    display: none;
}

TraceViewerScreen #trace_content {
    height: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

TraceViewerScreen #trace_content.hidden {
    display: none;
}

TraceViewerScreen #trace_detail {
    height: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

TraceViewerScreen #trace_detail:focus {
    border: none;
}

TraceViewerScreen .search-container {
    height: 1;
    display: none;
    background: transparent;
    margin: 0;
    padding: 0;
}

TraceViewerScreen .search-container.visible {
    display: block;
}

TraceViewerScreen .search-container Input {
    width: 100%;
    height: 1;
    border: none;
    background: $surface;
}

TraceViewerScreen .search-container Input:focus {
    border: none;
}

/* TraceFilterRow Widget Styles - Single-row filter header */
TraceFilterRow {
    height: 1;
    background: transparent;
    padding: 0;
    margin: 0;
}

TraceFilterRow .filter-row {
    height: 1;
    background: transparent;
    align: left middle;
    padding: 0;
    margin: 0;
}

/* Leading spacer to align with DataTable cursor indicator */
TraceFilterRow .filter-cursor-spacer {
    width: 1;
    height: 1;
    background: transparent;
    padding: 0;
    margin: 0;
}

/* Time filter clickable label - 12 char time + 1 space */
TraceFilterRow .filter-time {
    width: 13;
    height: 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
    padding: 0;
    margin: 0;
}

TraceFilterRow .filter-time:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* Severity filter clickable label - 3 char code + 1 space */
TraceFilterRow .filter-sev {
    width: 4;
    height: 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
    padding: 0;
    margin: 0;
}

TraceFilterRow .filter-sev:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* Source filter clickable label - 20 char source */
TraceFilterRow .filter-source {
    width: 20;
    height: 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
    padding: 0;
    margin: 0;
}

TraceFilterRow .filter-source:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* Message filter input - remaining space */
TraceFilterRow .filter-message {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
    padding: 0;
    margin: 0;
}

TraceFilterRow .filter-message > .input--placeholder {
    color: $primary;
    text-style: bold;
}

TraceFilterRow .filter-message:focus {
    background: transparent;
}

TraceFilterRow .filter-message:focus > .input--placeholder {
    color: $text-muted;
}

/* Select dropdown overlay styles */
/* Solid background so dropdown options are visible */
TraceFilterRow SelectOverlay {
    background: $surface;
    border: solid $primary;
}

TraceFilterRow SelectOverlay > OptionList {
    background: $surface;
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

TraceFilterRow SelectOverlay > OptionList:focus {
    background: $surface;
    border: none;
}

TraceFilterRow SelectOverlay > OptionList > .option-list--option {
    background: $surface;
    color: $foreground;
    padding: 0 1;
}

TraceFilterRow SelectOverlay > OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $background;
}

TraceFilterRow SelectOverlay > OptionList > .option-list--option-hover {
    background: $panel;
    color: $foreground;
}

/* SourceFilterPopup styles */
/* Note: DEFAULT_CSS in the widget handles layer, width, height, etc. */
/* Background is transparent to show content behind */
/* Border is on the inner Vertical container, not the screen itself */
SourceFilterPopup {
    background: transparent;
    border: none;
    padding: 0;
}

SourceFilterPopup .popup-title {
    color: $primary;
    text-style: bold;
    background: transparent;
}

SourceFilterPopup SelectionList {
    background: transparent;
    border: none;
    height: auto;
    max-height: 12;
}

SourceFilterPopup SelectionList:focus {
    background: transparent;
    border: none;
}

SourceFilterPopup .selection-list--button {
    background: transparent;
    color: $foreground;
    padding: 0 1;
    height: 1;
}

SourceFilterPopup .selection-list--button-highlighted {
    background: $primary;
    color: $background;
}

SourceFilterPopup .selection-list--button-selected {
    color: $success;
}

SourceFilterPopup .selection-list--button-selected-highlighted {
    background: $primary;
    color: $background;
}

SourceFilterPopup .popup-help {
    color: $text-muted;
    background: transparent;
    margin-bottom: 1;
}

/* SeverityFilterPopup styles */
/* Similar to SourceFilterPopup but with RadioSet instead of SelectionList */
SeverityFilterPopup {
    background: transparent;
    border: none;
    padding: 0;
}

SeverityFilterPopup .popup-title {
    color: $primary;
    text-style: bold;
    background: transparent;
}

SeverityFilterPopup .popup-help {
    color: $text-muted;
    background: transparent;
    margin-bottom: 1;
}

SeverityFilterPopup RadioSet {
    background: transparent;
    border: none;
    height: auto;
}

SeverityFilterPopup RadioSet:focus {
    background: transparent;
    border: none;
}

SeverityFilterPopup RadioButton {
    background: transparent;
    color: $foreground;
    padding: 0;
    height: 1;
}

SeverityFilterPopup RadioButton:focus {
    background: $primary;
    color: $background;
}

SeverityFilterPopup RadioButton.-on {
    color: $success;
}

SeverityFilterPopup RadioButton.-on:focus {
    background: $primary;
    color: $background;
}

/* TimeFilterPopup styles */
/* Similar to SeverityFilterPopup but for time range selection */
TimeFilterPopup {
    background: transparent;
    border: none;
    padding: 0;
}

TimeFilterPopup .popup-title {
    color: $primary;
    text-style: bold;
    background: transparent;
}

TimeFilterPopup .popup-help {
    color: $text-muted;
    background: transparent;
    margin-bottom: 1;
}

TimeFilterPopup RadioSet {
    background: transparent;
    border: none;
    height: auto;
}

TimeFilterPopup RadioSet:focus {
    background: transparent;
    border: none;
}

TimeFilterPopup RadioButton {
    background: transparent;
    color: $foreground;
    padding: 0;
    height: 1;
}

TimeFilterPopup RadioButton:focus {
    background: $primary;
    color: $background;
}

TimeFilterPopup RadioButton.-on {
    color: $success;
}

TimeFilterPopup RadioButton.-on:focus {
    background: $primary;
    color: $background;
}

/* HelpScreen Layout */
HelpScreen {
    layout: vertical;
}

HelpScreen .help-header {
    height: 1;
    background: transparent;
    text-align: center;
}

HelpScreen .help-title {
    text-style: bold;
    color: $primary;
}

HelpScreen #help_viewer {
    height: 1fr;
    margin: 0 1;
    background: transparent;
}

HelpScreen #help_viewer > MarkdownH1 {
    color: $primary;
    text-style: bold;
    margin: 1 0;
}

HelpScreen #help_viewer > MarkdownH2 {
    color: $secondary;
    text-style: bold;
    margin: 1 0 0 0;
}

HelpScreen #help_viewer > MarkdownH3 {
    color: $accent;
    text-style: bold;
}

HelpScreen #help_viewer > MarkdownBulletList {
    margin: 0 0 0 2;
}

HelpScreen #help_viewer > MarkdownFence {
    background: $surface;
    margin: 0 2;
    padding: 1;
}

HelpScreen .help-footer {
    height: 1;
    background: transparent;
    text-align: center;
    color: $text-muted;
}

/* AssignConfigurationModal Layout */
AssignConfigurationModal {
    align: center middle;
}

AssignConfigurationModal #dialog {
    width: 70;
    height: auto;
    max-height: 30;
    border: thick $primary;
    background: transparent;
    padding: 1 2;
}

AssignConfigurationModal .screen-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $primary;
    background: transparent;
    margin-bottom: 1;
}

AssignConfigurationModal .mode-indicator {
    width: 100%;
    height: 1;
    content-align: center middle;
    background: $accent;
    color: $background;
    text-style: bold;
    margin-bottom: 1;
}

AssignConfigurationModal .info-line {
    color: $text-muted;
    background: transparent;
    margin: 0 0 1 0;
}

AssignConfigurationModal .input-container {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    background: transparent;
}

AssignConfigurationModal Input {
    width: 100%;
    border: solid $primary;
}

AssignConfigurationModal Input:focus {
    border: solid $accent;
}

AssignConfigurationModal Input:disabled {
    opacity: 0.6;
    border: solid $border;
}

AssignConfigurationModal .list-container {
    width: 100%;
    height: 15;
    border: solid $primary;
    margin-bottom: 1;
    background: transparent;
}

AssignConfigurationModal ListView {
    width: 100%;
    height: 100%;
    background: transparent;
}

AssignConfigurationModal .hint {
    color: $warning;
    background: transparent;
    margin-bottom: 1;
}

AssignConfigurationModal .status-bar {
    height: 1;
    color: $text-muted;
    background: transparent;
}

/* DocumentViewScreen Layout */
DocumentViewScreen {
    layout: vertical;
}

DocumentViewScreen .main-content {
    layout: horizontal;
    height: 1fr;
}

DocumentViewScreen .left-pane {
    width: 70%;
    layout: vertical;
}

DocumentViewScreen .right-pane {
    width: 30%;
    border: none;
    layout: vertical;
    background: transparent;
}

DocumentViewScreen .config-panel-header {
    height: 1;
    text-align: center;
    text-style: bold;
    background: transparent;
    color: $primary;
    padding: 0;
}

DocumentViewScreen .config-list-container {
    height: 1fr;
    overflow-y: auto;
    background: transparent;
}

DocumentViewScreen .config-list-container ListView {
    height: auto;
    background: transparent;
    padding: 0;
    border: none;
}

DocumentViewScreen .config-list-container ListItem {
    height: 1;
    padding: 0 1;
    margin: 0;
    background: transparent;
}

DocumentViewScreen .config-list-container ListItem > Label {
    height: 1;
    padding: 0;
    margin: 0;
}

DocumentViewScreen .left-pane TextArea {
    border: none;
    padding: 0;
}

DocumentViewScreen .left-pane TextArea:focus {
    border: none;
}

DocumentViewScreen .left-pane TextArea > .text-area--cursor {
    background: transparent;
    color: transparent;
}

DocumentViewScreen .left-pane TextArea:focus > .text-area--cursor {
    background: $foreground;  /* Cursor color */
    color: $background;
}

DocumentViewScreen .config-list-empty {
    height: 100%;
    padding: 1;
    color: $text-muted;
    text-align: center;
}

DocumentViewScreen .assignment-time-container {
    height: auto;
    min-height: 2;
    background: transparent;
    padding: 0;
}

DocumentViewScreen .assignment-time-label {
    text-style: bold;
    color: $primary;
    margin-bottom: 0;
    background: transparent;
}

DocumentViewScreen .assignment-time-value {
    color: $text;
    background: transparent;
}

DocumentViewScreen JSONViewer {
    height: 1fr;
    margin: 0;
}

DocumentViewScreen .left-pane ScrollBar {
    background: $surface;
}

DocumentViewScreen .config-list-container ScrollBar {
    background: $surface;
}

/* ===========================================
   Database Utilities Screens
   =========================================== */

/* DatabaseUtilitiesScreen Layout */
DatabaseUtilitiesScreen {
    layout: vertical;
}

DatabaseUtilitiesScreen .utilities-menu-container {
    height: auto;
    align: center middle;
    padding: 2 4;
    background: transparent;
}

DatabaseUtilitiesScreen #utilities_menu {
    height: auto;
    width: auto;
    background: transparent;
}

DatabaseUtilitiesScreen .utilities-info-container {
    height: auto;
    align: center middle;
    padding: 1 4;
    background: transparent;
}

DatabaseUtilitiesScreen .menu-description {
    text-align: center;
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

DatabaseUtilitiesScreen .server-info {
    text-align: center;
    color: $primary;
    text-style: bold;
    height: 1;
}

/* DatabaseDoctorScreen Layout - mirrors DatabaseUtilitiesScreen */
DatabaseDoctorScreen {
    layout: vertical;
}

DatabaseDoctorScreen .utilities-menu-container {
    height: auto;
    align: center middle;
    padding: 2 4;
    background: transparent;
}

DatabaseDoctorScreen #doctor_menu {
    height: auto;
    width: auto;
    background: transparent;
}

DatabaseDoctorScreen .utilities-info-container {
    height: auto;
    align: center middle;
    padding: 1 4;
    background: transparent;
}

DatabaseDoctorScreen .menu-description {
    text-align: center;
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

DatabaseDoctorScreen .server-info {
    text-align: center;
    color: $primary;
    text-style: bold;
    height: 1;
}

DatabaseDoctorScreen #loading_progress {
    width: 100%;
    height: 1;
    background: transparent;
    margin: 1 4;
}

/* ServerStatsScreen Layout */
ServerStatsScreen {
    layout: vertical;
}

ServerStatsScreen #stats_content {
    height: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

ServerStatsScreen #stats_content:focus {
    border: none;
}

/* DatabaseStatsScreen Layout */
DatabaseStatsScreen {
    layout: vertical;
}

DatabaseStatsScreen .db-buttons-row {
    height: 1;
    padding: 0;
    margin: 0;
    background: transparent;
    align: left middle;
}

DatabaseStatsScreen .db-select-btn {
    height: 1;
    min-width: 8;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $accent;
    color: $text;
}

DatabaseStatsScreen .db-select-btn:hover {
    background: $accent;
}

DatabaseStatsScreen .db-select-btn:focus {
    background: $accent;
    color: $text;
    border: none;
    text-style: bold;
}

DatabaseStatsScreen .db-btn-selected {
    background: $primary;
    color: $background;
    text-style: bold;
}

DatabaseStatsScreen .db-btn-selected:hover {
    background: $accent;
}

DatabaseStatsScreen .db-btn-selected:focus {
    background: $accent;
    color: $text;
    text-style: bold;
}

DatabaseStatsScreen .db-no-databases {
    height: 1;
    color: $text-muted;
}

DatabaseStatsScreen #stats_content {
    height: 1fr;
    margin: 0;
    border: none;
    background: transparent;
}

DatabaseStatsScreen #stats_content:focus {
    border: none;
}

/* BackupScreen, RestoreScreen, and RecreateIndexesScreen Layout */
BackupScreen, RestoreScreen, RecreateIndexesScreen {
    layout: vertical;
}

BackupScreen .db-buttons-row, RestoreScreen .db-buttons-row, RecreateIndexesScreen .db-buttons-row {
    height: 1;
    padding: 0;
    margin: 0;
    background: transparent;
    align: left middle;
}

BackupScreen .db-select-btn, RestoreScreen .db-select-btn, RecreateIndexesScreen .db-select-btn {
    height: 1;
    min-width: 8;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $accent;
    color: $text;
}

BackupScreen .db-select-btn:hover, RestoreScreen .db-select-btn:hover, RecreateIndexesScreen .db-select-btn:hover {
    background: $accent;
}

BackupScreen .db-select-btn:focus, RestoreScreen .db-select-btn:focus, RecreateIndexesScreen .db-select-btn:focus {
    background: $accent;
    color: $text;
    border: none;
    text-style: bold;
}

BackupScreen .db-btn-selected, RestoreScreen .db-btn-selected, RecreateIndexesScreen .db-btn-selected {
    background: $primary;
    color: $background;
    text-style: bold;
}

BackupScreen .db-btn-selected:hover, RestoreScreen .db-btn-selected:hover, RecreateIndexesScreen .db-btn-selected:hover {
    background: $accent;
}

BackupScreen .db-btn-selected:focus, RestoreScreen .db-btn-selected:focus, RecreateIndexesScreen .db-btn-selected:focus {
    background: $accent;
    color: $text;
    text-style: bold;
}

BackupScreen .backup-info-row, RestoreScreen .backup-info-row, RecreateIndexesScreen .backup-info-row {
    height: 1;
    padding: 0 1;
    margin: 0;
    color: $text-muted;
    background: transparent;
}

BackupScreen #output_log, RestoreScreen #output_log, RecreateIndexesScreen #output_log {
    height: 1fr;
    margin: 0 1;
    border: solid $border;
    background: transparent;
}

BackupScreen #output_log:focus, RestoreScreen #output_log:focus, RecreateIndexesScreen #output_log:focus {
    border: solid $primary;
}

/* RestoreScreen and BackupScreen shared styles */
BackupScreen .restore-dir-row, RestoreScreen .restore-dir-row {
    height: 1;
    padding: 0 1;
    margin: 0;
    background: transparent;
}

BackupScreen #backup_dir_info, RestoreScreen #backup_dir_info {
    width: 1fr;
    color: $text-muted;
    background: transparent;
}

BackupScreen .browse-btn, RestoreScreen .browse-btn {
    height: 1;
    min-width: 10;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $surface;
    color: $text;
}

BackupScreen .browse-btn:hover, RestoreScreen .browse-btn:hover {
    background: $panel;
    color: $text;
}

BackupScreen .browse-btn:focus, RestoreScreen .browse-btn:focus {
    background: $primary;
    color: $background;
}

BackupScreen .restore-file-row, RestoreScreen .restore-file-row {
    height: 1;
    padding: 0 1;
    margin: 0;
    background: transparent;
    align: left middle;
}

BackupScreen .restore-file-label, RestoreScreen .restore-file-label {
    width: 5;
    color: $text-muted;
    background: transparent;
}

BackupScreen #backup_file_info {
    width: 1fr;
    color: $text-muted;
    background: transparent;
}

RestoreScreen .backup-file-select {
    width: 1fr;
    height: 1;
    margin: 0;
    border: none;
    background: transparent;
}

RestoreScreen .backup-file-select:focus {
    border: none;
}

RestoreScreen .backup-file-select > SelectCurrent {
    background: transparent;
    border: none;
    padding: 0;
}

RestoreScreen .backup-file-select:focus > SelectCurrent {
    background: $primary;
    color: $background;
}

RestoreScreen .wipe-btn {
    height: 1;
    min-width: 10;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $surface;
    color: $text;
    dock: right;
}

RestoreScreen .wipe-btn:hover {
    background: $panel;
    color: $text;
}

RestoreScreen .wipe-btn:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

RestoreScreen .wipe-btn-active {
    background: $warning;
    color: $background;
    text-style: bold;
}

RestoreScreen .wipe-btn-active:hover {
    background: $error;
}

RestoreScreen .wipe-btn-active:focus {
    background: $warning;
    color: $background;
}

/* DirectoryBrowserModal styles */
DirectoryBrowserModal {
    align: center middle;
}

DirectoryBrowserModal .dir-browser-dialog {
    width: 80%;
    height: 80%;
    max-width: 100;
    max-height: 30;
    background: $background;
    border: thick $primary;
    padding: 1;
}

DirectoryBrowserModal .dir-browser-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    height: 1;
    margin-bottom: 1;
}

DirectoryBrowserModal .dir-browser-content {
    height: 1fr;
    background: transparent;
}

DirectoryBrowserModal .dir-tree {
    width: 50%;
    height: 100%;
    background: transparent;
    border: solid $border;
}

DirectoryBrowserModal .dir-tree:focus {
    border: solid $primary;
}

DirectoryBrowserModal .dir-info-pane {
    width: 50%;
    height: 100%;
    padding: 0 1;
    background: transparent;
}

DirectoryBrowserModal .dir-info-label {
    color: $text-muted;
    height: 1;
}

DirectoryBrowserModal .selected-dir {
    color: $text;
    height: 2;
    margin-bottom: 1;
}

DirectoryBrowserModal .dir-contents {
    color: $secondary;
    height: 1;
}

DirectoryBrowserModal .dir-browser-buttons {
    height: 3;
    align: center middle;
    background: transparent;
    margin-top: 1;
}

DirectoryBrowserModal .dir-browser-buttons Button {
    margin: 0 1;
}

RestoreScreen .db-no-databases {
    height: 1;
    color: $text-muted;
}

BackupScreen .db-no-databases {
    height: 1;
    color: $text-muted;
}

/* ===========================================
   Configuration Editor Screen
   =========================================== */

ConfigEditorScreen {
    layout: vertical;
}

ConfigEditorScreen .config-main-content {
    height: 1fr;
    background: transparent;
}

ConfigEditorScreen .config-tree-pane {
    width: 50%;
    border-right: solid $border;
    background: transparent;
    padding: 0 1;
}

ConfigEditorScreen .config-editor-pane {
    width: 50%;
    background: transparent;
    padding: 0 1;
}

ConfigEditorScreen .pane-title {
    height: 1;
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 1;
}

ConfigEditorScreen #config_tree {
    height: 1fr;
    background: transparent;
    border: none;
}

ConfigEditorScreen #config_tree:focus {
    border: none;
}

ConfigEditorScreen .selected-path {
    height: 1;
    color: $secondary;
    margin-bottom: 1;
}

ConfigEditorScreen .field-description {
    height: 2;
    color: $text-muted;
    margin-bottom: 1;
}

ConfigEditorScreen #config_value_input {
    margin-bottom: 1;
}

ConfigEditorScreen .editor-buttons {
    height: 3;
    align: left middle;
}

ConfigEditorScreen .editor-buttons Button {
    margin-right: 1;
}

ConfigEditorScreen .config-footer-buttons {
    height: 3;
    align: center middle;
    background: transparent;
    padding: 0 1;
}

ConfigEditorScreen .config-footer-buttons Button {
    margin: 0 1;
}

ConfigEditorScreen Button.-success {
    background: $success;
    color: $background;
}

ConfigEditorScreen Button.-success:hover {
    background: $primary;
}

/* Tree widget styles */
Tree {
    background: transparent;
}

Tree:focus {
    border: none;
}

Tree > .tree--guides {
    color: $border;
}

Tree > .tree--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}

Tree > .tree--highlight {
    background: $panel;
}

Tree > .tree--highlight-line {
    background: transparent;
}

/* Hidden class for dynamic visibility */
.hidden {
    display: none;
}

/* Validation status styling */
ConfigEditorScreen .validation-status {
    height: 1;
    margin-bottom: 1;
}

/* RadioSet styling for discrete value selection */
ConfigEditorScreen #config_radio_set {
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
}

ConfigEditorScreen #config_radio_set RadioButton {
    background: transparent;
    padding: 0;
    height: 1;
    margin-bottom: 0;
}

ConfigEditorScreen #config_radio_set RadioButton > .toggle--label {
    color: $text;
    padding-left: 1;
}

ConfigEditorScreen #config_radio_set RadioButton:focus > .toggle--label {
    color: $accent;
    text-style: bold;
}

ConfigEditorScreen #config_radio_set RadioButton.-on > .toggle--button {
    color: $success;
}

ConfigEditorScreen #config_radio_set RadioButton.-on > .toggle--label {
    color: $success;
}

ConfigEditorScreen #config_radio_set RadioButton:focus > .toggle--button {
    background: transparent;
}

/* Validate path button */
ConfigEditorScreen #validate_path_btn {
    margin-left: 1;
}

/* ===========================================
   Loading Progress Widget
   =========================================== */

.loading-progress {
    height: 3;
    background: transparent;
    padding: 0 1;
    margin: 1 0;
}

.loading-progress .loading-row {
    height: 1;
    background: transparent;
    align: left middle;
}

.loading-progress .clock-display {
    width: 12;
    color: $warning;
    text-style: bold;
    background: transparent;
}

.loading-progress .progress-container {
    width: 20;
    height: 1;
    background: transparent;
}

.loading-progress ProgressBar {
    width: 100%;
    height: 1;
    background: transparent;
    border: none;
}

.loading-progress ProgressBar > .bar--bar {
    background: transparent;
    border: none;
}

.loading-progress ProgressBar > .bar--complete {
    color: $primary;
}

.loading-progress .news-feed {
    width: 1fr;
    color: $secondary;
    background: transparent;
    padding-left: 2;
}

/* RepairConfigurationListScreen specific styles */
RepairConfigurationListScreen {
    layout: vertical;
}

RepairConfigurationListScreen #loading_progress {
    width: 100%;
    height: 1;
    background: transparent;
    margin: 0 2;
}

/* DatabaseDoctorScreen HN Content Area */
DatabaseDoctorScreen #hn_scroll {
    height: 1fr;
    margin: 0 2;
    border: none;
    background: transparent;
    scrollbar-size: 0 0;
}

DatabaseDoctorScreen #hn_content {
    width: 100%;
    height: auto;
    background: transparent;
    color: $text;
}

/* =============================================================================
   JSON Diff/Merge Screen
   ============================================================================= */

JSONDiffMergeScreen {
    layout: vertical;
}

JSONDiffMergeScreen #doc-header-row {
    height: auto;
    margin: 0 1;
    align: left middle;
}

JSONDiffMergeScreen #doc-header {
    width: 1fr;
}

JSONDiffMergeScreen #swap-btn {
    width: auto;
    min-width: 10;
}

JSONDiffMergeScreen #toolbar {
    height: auto;
    margin: 0 1 1 1;
}

JSONDiffMergeScreen #main-panels {
    height: 1fr;
    width: 100%;
    margin: 0;
}

JSONDiffMergeScreen #json-tree {
    height: 1fr;
    scrollbar-size: 0 0;
}

JSONDiffMergeScreen #diff-table {
    height: 1fr;
    width: 100%;
    margin: 0;
}

JSONDiffMergeScreen #diff-table > .datatable--header {
    padding: 0;
}

JSONDiffMergeScreen #diff-status-bar {
    height: auto;
    background: $secondary;
    color: $background;
    text-style: bold;
    padding: 0 1;
    margin: 0;
}

/* Diff table first column (Act) - single char width, no padding */
JSONDiffMergeScreen #diff-table > .datatable--header-cell:first-child,
JSONDiffMergeScreen #diff-table > .datatable--cell:first-child {
    padding: 0;
    width: 1;
}
